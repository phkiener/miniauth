@page "/showcase/button"
@layout ShowcaseLayout

<section>
    <header>Buttons</header>

    <section>
        <header>Default</header>

        <button type="button">Normal button</button>
        <button type="submit">Submit button</button>
        <button type="reset">Reset button</button>
    </section>

    <section>
        <header>Primary</header>

        <button type="button" class="primary">Normal button</button>
        <button type="submit" class="primary">Submit button</button>
        <button type="reset" class="primary">Reset button</button>
    </section>

    <section>
        <header>Secondary</header>

        <button type="button" class="secondary">Normal button</button>
        <button type="submit" class="secondary">Submit button</button>
        <button type="reset" class="secondary">Reset button</button>
    </section>
</section>

<section>
    <header>Link buttons</header>

    <section>
        <header>Default</header>

        <a role="button" tabindex="0">Link Button</a>
    </section>

    <section>
        <header>Primary</header>

        <a role="button" tabindex="0" class="primary">Link Button</a>
    </section>

    <section>
        <header>Secondary</header>

        <a role="button" tabindex="0" class="secondary">Link Button</a>
    </section>
</section>


<section>
    <header>Button-type inputs</header>

    <section>
        <header>Default</header>

        <input type="button" value="Button input">
        <input type="submit" value="Submit input">
        <input type="reset" value="Reset input">
    </section>

    <section>
        <header>Primary</header>

        <input type="button" value="Button input" class="primary">
        <input type="submit" value="Submit input" class="primary">
        <input type="reset" value="Reset input" class="primary">
    </section>

    <section>
        <header>Secondary</header>

        <input type="button" value="Button input" class="secondary">
        <input type="submit" value="Submit input" class="secondary">
        <input type="reset" value="Reset input" class="secondary">
    </section>
</section>
