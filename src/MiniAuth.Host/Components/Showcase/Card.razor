@page "/showcase/card"
@layout ShowcaseLayout

<section>
    <header>Content only</header>

    <div class="card">
        <span>This is some text</span>
    </div>
</section>

<section>
    <header>Header + footer</header>

    <div class="card">
        <header>Card title</header>
        <span>This is some text</span>
        <footer>Card footer</footer>
    </div>
</section>

<section>
    <header>Complex card</header>

    <div class="card">
        <header>Review</header>

        <p>
            How do you like the styles so far?
        </p>

        <footer>
            <button type="button" class="primary">Love them</button>
            <button type="button">Hate them</button>
        </footer>
    </div>
</section>
