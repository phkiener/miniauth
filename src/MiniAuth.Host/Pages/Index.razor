@page "/"
@attribute [RequireAntiforgeryToken(required: false)]

<main>
    <article class="card" style="margin-block: auto">
        @if (username is null)
        {
            <p>You are not logged in.</p>

            <footer>
                <a href="/login" role="button" class="primary" tabindex="0">Log in</a>
            </footer>

        }
        else
        {
            <EditForm Model="@this" FormName="logout" OnSubmit="@LogoutAsync" id="logout" hidden />

            <header>
                Hello, @username
            </header>

            <dl>
                <dt>Username</dt>
                <dd>@username</dd>

                <dt>Groups</dt>
                <dd>
                    @foreach (var group in groups)
                    {
                        @group <br/>
                    }
                </dd>
            </dl>

            <p>
                Groups are synchronized from the system groups. To refresh, log in again.
                All account modifications need to be done by the administrator.
            </p>

            <footer>
                <button type="submit" form="logout">Log out</button>
            </footer>
        }
    </article>
</main>
